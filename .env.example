# # Absolute path to the Obsidian vault folder on disk that the MCP server
# # reads and writes notes from. All note paths are resolved relative to
# # this root and may not escape it.
# OBSIDIAN_VAULT_PATH=/path/to/your/vault

# # Bearer token required on every request to /mcp. Generate a long random
# # value, e.g.: openssl rand -hex 32
# MCP_AUTH_TOKEN=change-me

# Path to the SQLite database file used by Drizzle ORM.
DB_FILE_NAME=./src/lib/db/local.db
